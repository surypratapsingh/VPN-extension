{
  "manifest_version": 3,
  "name": "GeoSwitch VPN",
  "version": "0.1.0",
  "description": "Switch your browsing location by connecting through your own proxy servers.",
  "permissions": ["proxy", "storage", "webRequest", "webRequestAuthProvider"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GeoSwitch VPN"
  },
  "options_page": "options.html"
}
